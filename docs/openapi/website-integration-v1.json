          },
          "api_version": {
            "const": "v1"
          },
          "contract_version": {
            "const": "2026-07-24.2"
          },
          "configuration": {
            "type": "object",
            "required": [
              "required_environment_variables",
              "api_base_url",
              "application_reference_location",
              "tenant_id_environment_required",
              "company_id_environment_required"
            ],
            "properties": {
              "required_environment_variables": {
                "type": "array",
                "prefixItems": [
                  {
                    "const": "GRIDEX_API_KEY"
                  }
                ],
                "minItems": 1,
                "maxItems": 1
              },
              "api_base_url": {
                "const": "https://app.gridex.se/api/v1"
              },
              "application_reference_location": {
                "const": "top_level"
              },
              "tenant_id_environment_required": {
                "const": false
              },
              "company_id_environment_required": {
                "const": false
              }
            }
          },
          "capabilities": {
            "type": "object",
            "required": [
              "website_checkout_ready",
              "missing_website_scopes"
            ],
            "properties": {
              "website_checkout_ready": {
                "type": "boolean"
              },
              "required_website_scopes": {
                "type": "array",
