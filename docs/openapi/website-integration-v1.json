        "type": "object",
        "required": [
          "tenant_reference",
          "api_version",
          "contract_version",
          "configuration",
          "capabilities"
        ],
        "properties": {
          "tenant_reference": {
            "type": "string"
          },
          "company_id": {
            "type": [
              "string",
              "null"
            ]
