NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for external CIS/factoring systems.
GRIDEX_INTEGRATION_API_KEY=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET when configured.
CRON_SECRET=

# Optional override. Defaults to elprisetjustnu.se.
SPOT_PRICE_API_URL_TEMPLATE=https://www.elprisetjustnu.se/api/v1/prices/{YEAR}/{MONTH}-{DAY}_{AREA}.json

# CIS integration. Keep sandbox enabled until production provider is verified.
CIS_API_BASE_URL=
CIS_API_KEY=
CIS_WEBHOOK_SECRET=
CIS_SANDBOX_MODE=true

# Personal identity protection.
PII_HASH_PEPPER=
PII_ENCRYPTION_KEY=

# Gridex OPS website integration. Server-side only; never expose these with NEXT_PUBLIC_.
GRIDEX_OPS_API_URL=https://app.gridex.se
GRIDEX_WEBSITE_API_KEY=
GRIDEX_WEBSITE_TENANT_ID=
GRIDEX_ENABLE_LIVE_SIGNUP=false
GRIDEX_WEBSITE_HASH_PEPPER=
GRIDEX_WEBSITE_APPLICATION_PREFIX=GRIDEX-WEB

# Public production URL used for absolute auth redirects and metadata.
NEXT_PUBLIC_SITE_URL=https://gridex.se

# Public pricing fallback. Keep disabled in production; OPS remains binding source.
GRIDEX_ENABLE_LOCAL_PRICE_FALLBACK=false
GRIDEX_ALLOW_UNSAFE_OPS_URL=false

# OPS webhook verification for customer/application events.
GRIDEX_ENABLE_OPS_WEBHOOKS=false
GRIDEX_OPS_WEBHOOK_SECRET=
GRIDEX_OPS_WEBHOOK_TOLERANCE_SECONDS=300

# Supabase storage bucket for signed contract/customer documents.
CONTRACTS_BUCKET=contracts

# Postnummer/adress -> elområde resolution.
PAPILITE_API_KEY=
PAPILITE_BASE_URL=https://api.papapi.se/lite/
WEBSITE_ARCGIS_GRID_AREAS_QUERY_URL=https://services2.arcgis.com/L8WLzcxhwLqd80Jx/arcgis/rest/services/N%C3%A4tomr%C3%A5den_240524_2_WFL1/FeatureServer/4/query
