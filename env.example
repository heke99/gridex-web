NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for external CIS/factoring systems.
GRIDEX_INTEGRATION_API_KEY=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET when configured.
CRON_SECRET=

# Optional override. Defaults to elprisetjustnu.se.
SPOT_PRICE_API_URL_TEMPLATE=https://www.elprisetjustnu.se/api/v1/prices/{YEAR}/{MONTH}-{DAY}_{AREA}.json

# CIS integration. Keep sandbox enabled until production provider is verified.
CIS_API_BASE_URL=
CIS_API_KEY=
CIS_WEBHOOK_SECRET=
CIS_SANDBOX_MODE=true

# Personal identity protection.
PII_HASH_PEPPER=
PII_ENCRYPTION_KEY=
