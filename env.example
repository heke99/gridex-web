NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for external CIS/factoring systems.
GRIDEX_INTEGRATION_API_KEY=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET when configured.
CRON_SECRET=

# Optional source for the standalone informational “elpris idag” feature.
# It is never used to create or modify the customer checkout quote.
SPOT_PRICE_API_URL_TEMPLATE=https://www.elprisetjustnu.se/api/v1/prices/{YEAR}/{MONTH}-{DAY}_{AREA}.json

# CIS integration. Keep sandbox enabled until production provider is verified.
CIS_API_BASE_URL=
CIS_API_KEY=
CIS_WEBHOOK_SECRET=
CIS_SANDBOX_MODE=true

# Personal identity protection and server-side token derivation.
PII_HASH_PEPPER=
PII_ENCRYPTION_KEY=

# Gridex OPS website integration. Server-side only; never expose with NEXT_PUBLIC_.
# The full API key identifies the tenant. No company ID, tenant ID or manual scope list is needed.
GRIDEX_WEBSITE_API_KEY=
# Optional override. Defaults to https://app.gridex.se.
GRIDEX_OPS_API_URL=https://app.gridex.se
GRIDEX_OPS_TIMEOUT_MS=12000
GRIDEX_OPS_ALLOWED_HOSTS=app.gridex.se
GRIDEX_ALLOW_UNSAFE_OPS_URL=false

# Emergency kill switch. Live signup is enabled when this is false.
GRIDEX_DISABLE_LIVE_SIGNUP=false
# Emergency compatibility only. Production should keep both false.
GRIDEX_ENABLE_LEGACY_PORTAL_BUNDLE_COMPATIBILITY=false
GRIDEX_ENABLE_LEGACY_WEBSITE_CONTRACTS_ROUTE=false

# Gridex sends Supabase invite/create-password mail after OPS accepts an application.
GRIDEX_ENABLE_PORTAL_ONBOARDING=true
GRIDEX_WEBSITE_APPLICATION_PREFIX=GRIDEX-WEB
GRIDEX_WEBSITE_CUSTOMER_PREFIX=GRIDEX-WEB-CUSTOMER
GRIDEX_WEBSITE_SOURCE=gridex.se

# Optional dedicated HMAC secrets. When omitted, the server derives domain-separated
# keys from an existing private server secret such as PII_HASH_PEPPER or the Supabase
# service-role key. The OPS API key is never reused for browser-token signing.
GRIDEX_WEBSITE_PRICING_QUOTE_SECRET=
GRIDEX_WEBSITE_ENERGY_AREA_TOKEN_SECRET=

# Public production URL used for absolute auth redirects and metadata.
NEXT_PUBLIC_SITE_URL=https://gridex.se

# OPS webhook verification. Enable only after the signing secret is configured in OPS.
GRIDEX_ENABLE_OPS_WEBHOOKS=false
GRIDEX_WEBHOOK_SIGNING_SECRET=
# Deprecated compatibility alias. Do not set both aliases to different values.
GRIDEX_OPS_WEBHOOK_SECRET=
GRIDEX_OPS_WEBHOOK_TOLERANCE_SECONDS=300

# Customer portal write outbox and pending notification reconciliation.
# Vercel CRON_SECRET is also accepted as fallback.
CUSTOMER_PORTAL_OUTBOX_CRON_SECRET=

# Supabase storage bucket for signed contract/customer documents.
CONTRACTS_BUCKET=contracts

# SEO / Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Ads / GA4. Tags only load after cookie consent is accepted.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
