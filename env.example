NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for external CIS/factoring systems.

# Vercel Cron sends Authorization: Bearer $CRON_SECRET when configured.
CRON_SECRET=

# Optional source for the standalone informational “elpris idag” feature.
# It is never used to create or modify the customer checkout quote.
SPOT_PRICE_API_URL_TEMPLATE=https://www.elprisetjustnu.se/api/v1/prices/{YEAR}/{MONTH}-{DAY}_{AREA}.json

# CIS integration. Keep sandbox enabled until production provider is verified.
CIS_API_BASE_URL=
CIS_API_KEY=
CIS_WEBHOOK_SECRET=
CIS_SANDBOX_MODE=true

# Personal identity protection and server-side token derivation.
PII_HASH_PEPPER=
PII_ENCRYPTION_KEY=

# Gridex OPS website integration. Server-side only; never expose with NEXT_PUBLIC_.
# The API key resolves tenant, company, website channel and scopes through
# GET /api/v1/integration/context. No tenant identifier is sent separately.
GRIDEX_API_KEY=
# Canonical OPS API base. Use an approved staging origin only outside production.
GRIDEX_OPS_API_URL=https://app.gridex.se/api/v1
# Comma-separated HTTPS origins explicitly allowed outside production.
GRIDEX_OPS_STAGING_ALLOWED_ORIGINS=

# Optional operational controls. These do not identify the tenant and are not
# required for the canonical production setup.
GRIDEX_OPS_TIMEOUT_MS=12000
GRIDEX_DISABLE_LIVE_SIGNUP=false
GRIDEX_ENABLE_PORTAL_ONBOARDING=true
GRIDEX_WEBSITE_APPLICATION_PREFIX=GRIDEX-WEB
GRIDEX_WEBSITE_CUSTOMER_PREFIX=GRIDEX-WEB-CUSTOMER

# Dedicated HMAC keyring for all browser-safe checkout state. At least 32
# random bytes; do not reuse any Supabase, PII or integration secret.
GRIDEX_WEBSITE_STATE_SIGNING_SECRET=
GRIDEX_WEBSITE_STATE_SIGNING_KID=state-2026-07
GRIDEX_WEBSITE_STATE_SIGNING_PREVIOUS_SECRET=
GRIDEX_WEBSITE_STATE_SIGNING_PREVIOUS_KID=

# Encrypted short-lived checkout result token. Use a separate random secret of at least 32 characters.
# Configure this explicitly in every environment; never reuse a Supabase or webhook secret.
WEBSITE_RESULT_TOKEN_SECRET=

# Public production URL used for absolute auth redirects and metadata.
NEXT_PUBLIC_SITE_URL=https://gridex.se

# Canonical signed Gridex webhook verification.
GRIDEX_WEBHOOK_SIGNING_SECRET=
GRIDEX_WEBHOOK_TOLERANCE_SECONDS=300

# Retry/dead-letter worker for durable webhook projections. CRON_SECRET is accepted as fallback.
WEBHOOK_RETRY_CRON_SECRET=

# Evidence flags: set true only after the migration and staging checks are actually complete.
GRIDEX_WEBHOOK_PROJECTIONS_READY=false
GRIDEX_DATABASE_MIGRATIONS_READY=false

# Customer portal write outbox and pending notification reconciliation.
# Vercel CRON_SECRET is also accepted as fallback.
CUSTOMER_PORTAL_OUTBOX_CRON_SECRET=
CUSTOMER_PORTAL_ONBOARDING_CRON_SECRET=

# Supabase storage bucket for signed contract/customer documents.
CONTRACTS_BUCKET=contracts

# SEO / Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Ads / GA4. Tags only load after cookie consent is accepted.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
