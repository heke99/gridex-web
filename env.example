NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for external CIS/factoring systems.
GRIDEX_INTEGRATION_API_KEY=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET when configured.
CRON_SECRET=

# Optional override. Defaults to elprisetjustnu.se.
SPOT_PRICE_API_URL_TEMPLATE=https://www.elprisetjustnu.se/api/v1/prices/{YEAR}/{MONTH}-{DAY}_{AREA}.json

# CIS integration. Keep sandbox enabled until production provider is verified.
CIS_API_BASE_URL=
CIS_API_KEY=
CIS_WEBHOOK_SECRET=
CIS_SANDBOX_MODE=true

# Personal identity protection.
PII_HASH_PEPPER=
PII_ENCRYPTION_KEY=

# Gridex OPS website integration. Server-side only; never expose these with NEXT_PUBLIC_.
GRIDEX_OPS_API_URL=https://app.gridex.se
GRIDEX_OPS_TIMEOUT_MS=12000
# Comma-separated production hostname allowlist. HTTPS is always required in production.
GRIDEX_OPS_ALLOWED_HOSTS=app.gridex.se
# Full OPS integration token for “Gridex hemsida · Mina sidor”. Do not use the key_prefix such as gdxp_xxxxxxxx.
GRIDEX_WEBSITE_API_KEY=
# Optional aliases supported by the OPS client if your deployment already uses one of these names. Prefer GRIDEX_WEBSITE_API_KEY.
GRIDEX_CUSTOMER_PORTAL_API_KEY=
GRIDEX_OPS_CUSTOMER_PORTAL_API_KEY=
GRIDEX_OPS_API_KEY=
OPS_API_KEY=
# Comma-separated scopes assigned to the API key. Used by admin readiness;
# keep this in sync with OPS key administration.
GRIDEX_WEBSITE_API_SCOPES=integration_context.read,website_contracts.read,website_contracts.diagnostics,website_quotes.write,website_quotes.validate,website_energy_area.resolve,website_applications.write,website_switch_status.read,website_legal.read
# Emergency compatibility only. Production should keep this false. Fallback is
# allowed solely for explicit endpoint_not_found/method_not_supported errors.
GRIDEX_ENABLE_LEGACY_PORTAL_BUNDLE_COMPATIBILITY=false
GRIDEX_ENABLE_LEGACY_WEBSITE_CONTRACTS_ROUTE=false
GRIDEX_ENABLE_LIVE_SIGNUP=false
# Gridex sends Supabase invite/create-password mail after OPS accepts a website application.
GRIDEX_ENABLE_PORTAL_ONBOARDING=true
GRIDEX_WEBSITE_HASH_PEPPER=
GRIDEX_WEBSITE_APPLICATION_PREFIX=GRIDEX-WEB
GRIDEX_WEBSITE_CUSTOMER_PREFIX=GRIDEX-WEB-CUSTOMER
# Audit/source label sent to OPS. Set per tenant website deployment.
GRIDEX_WEBSITE_SOURCE=gridex.se

# Public production URL used for absolute auth redirects and metadata.
NEXT_PUBLIC_SITE_URL=https://gridex.se

GRIDEX_ALLOW_UNSAFE_OPS_URL=false

# OPS webhook verification for customer/application events.
GRIDEX_ENABLE_OPS_WEBHOOKS=true
# Opaque tenant reference returned by OPS integration context/meta. Requests and webhooks fail closed on mismatch.
# Optional defense-in-depth pinning. Normal drift works without this value.
GRIDEX_EXPECTED_TENANT_REFERENCE=
# Canonical secret name. Must exactly match OPS.
GRIDEX_WEBHOOK_SIGNING_SECRET=
# Deprecated compatibility alias. Do not set both aliases to different values.
GRIDEX_OPS_WEBHOOK_SECRET=
GRIDEX_OPS_WEBHOOK_TOLERANCE_SECONDS=300

# Customer portal write outbox and pending notification reconciliation.
# Vercel CRON_SECRET is also accepted as fallback.
CUSTOMER_PORTAL_OUTBOX_CRON_SECRET=

# Supabase storage bucket for signed contract/customer documents.
CONTRACTS_BUCKET=contracts

# Postnummer/adress -> elområde resolution.
PAPILITE_API_KEY=
PAPILITE_BASE_URL=https://api.papapi.se/lite/
WEBSITE_ARCGIS_GRID_AREAS_QUERY_URL=https://services2.arcgis.com/L8WLzcxhwLqd80Jx/arcgis/rest/services/N%C3%A4tomr%C3%A5den_240524_2_WFL1/FeatureServer/4/query

# Required in production for browser-to-server quote integrity.
# OPS /api/v1/website/quote is the only source for offer pricing.
# This secret signs the exact displayed OPS quote so it can be bound to the application.
# Use a unique random secret. Never reuse the OPS API token or the PII hashing pepper.
GRIDEX_WEBSITE_PRICING_QUOTE_SECRET=
# Separate signature for the OPS energy-area resolution token. May fall back to the quote secret,
# but a separate secret is recommended in production.
GRIDEX_WEBSITE_ENERGY_AREA_TOKEN_SECRET=
# REQUIRED before GRIDEX_ENABLE_LIVE_SIGNUP=true. OPS documentation must explicitly confirm
# where quote_reference belongs in customer-applications. Allowed values: top_level or contract.
# Leaving this blank blocks live signup rather than sending an undocumented field.
GRIDEX_OPS_APPLICATION_QUOTE_REFERENCE_MODE=
# Default consents_only sends only the documented dynamic consents map. Set top_level only when
# OPS OpenAPI/runtime documents the legal_acceptances array.
GRIDEX_OPS_APPLICATION_LEGAL_ACCEPTANCES_MODE=consents_only

# Mina sidor has separate readiness from checkout. Declare the actual scopes on the API key.
GRIDEX_CUSTOMER_PORTAL_API_SCOPES=customer_portal.read,customer_sync.write,customer_profile.read,customer_contracts.read,customer_sites.read,customer_invoices.read,customer_metering.read,customer_events.read,customer_documents.read,customer_legal.read,customer_power_of_attorney.read,customer_power_of_attorney.write,customer_notifications.read,customer_notifications.write,customer_contact.write,customer_facility_data.write
# Optional override when only a subset of portal features is enabled.
GRIDEX_CUSTOMER_PORTAL_REQUIRED_SCOPES=

# SEO / Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Ads / GA4. Tags only load after cookie consent is accepted.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
