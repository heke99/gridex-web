      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Vad behöver jag för att teckna elavtal?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Du behöver adress, uppskattad förbrukning, kontaktuppgifter och personnummer. Företag anger även organisationsnummer samt uppgifter om den behöriga personen som skriver under."
            }
          },
          {
            "@type": "Question",
            "name": "Hur vet jag vilket elområde jag tillhör?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Teckningsflödet fastställer automatiskt elområdet SE1–SE4 från adressen. Om adressen inte kan verifieras får du kontrollera den eller kontakta kundservice."
            }
          },
          {
            "@type": "Question",
            "name": "Vad ingår i priset och vad fakturerar nätägaren separat?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Teckningsflödet visar de publicerade komponenterna för elhandelsavtalet och beräknad moms. Elnätsavgift och nätabonnemang faktureras normalt separat av elnätsföretaget."
            }
          },
          {
            "@type": "Question",
            "name": "Vad är skillnaden mellan fast pris, månadspris, timpris, kvartspris och portföljpris?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Fast pris låser avtalets kWh-pris under den angivna perioden. Månadspris följer den publicerade månadsmodellen. Tim- och kvartspris prissätter användningen enligt respektive marknadsintervall. Portföljpris följer den avtalade portföljmodellen och dess låsta avgifter och andelar. De exakta avtalskomponenterna visas innan du tecknar."
            }
          }
        ]
      }
    ],
